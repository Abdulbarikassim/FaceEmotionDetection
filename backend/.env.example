# Copy this file to .env and fill in your own values. Never commit .env.

# Supabase > Connect > Connection string > URI > Session pooler
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Any long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me

# Supabase > Project Settings > API Keys (use the SECRET key; backend only)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-key

# Optional
# STORAGE_BUCKET=emotion-images
# FLASK_DEBUG=1
# PORT=3000
